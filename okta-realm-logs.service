[Unit]
Description=Okta Realm Log Viewer
After=network.target

[Service]
Type=simple
User=skylar
WorkingDirectory=/home/skylar/zachDemo/backend
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=5
EnvironmentFile=/home/skylar/zachDemo/backend/.env
StandardOutput=journal
StandardError=journal
SyslogIdentifier=okta-realm-logs

[Install]
WantedBy=multi-user.target
