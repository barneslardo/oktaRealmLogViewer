# Okta Tenant
OKTA_TENANT=https://your-tenant.oktapreview.com

# Authorization server issuer.
# IMPORTANT: use a CUSTOM authorization server, NOT /oauth2/default.
# The default auth server may have no access policies and will fail to issue tokens.
# Format: https://your-tenant.oktapreview.com/oauth2/<custom-auth-server-id>
OKTA_ISSUER=https://your-tenant.oktapreview.com/oauth2/your-auth-server-id

# Realm (default/primary realm ID; per-user resolution is automatic)
OKTA_REALM_ID=your-realm-id-here

# OIDC App (registered in Okta with private_key_jwt auth)
OKTA_CLIENT_ID=your-client-id
OKTA_REDIRECT_URI=https://your-domain.com/auth/callback
OKTA_POST_LOGOUT_URI=https://your-domain.com

# Private key in JWK format (single-line JSON string).
# Must pair with the public key registered on the OIDC app.
OKTA_PRIVATE_KEY_JWK={"kty":"RSA","use":"sig",...your-key-here...}

# Okta API token (SSWS) for the System Log + Users/Realms APIs
OKTA_API_TOKEN=your-api-token-here

# Comma-separated group IDs (or names) that grant GLOBAL access to
# Default-Realm users (members of a specific realm are always realm-scoped).
GLOBAL_ADMIN_GROUPS=your-global-admin-group-id

# Session encryption secret (generate: openssl rand -hex 32).
# Rotating this invalidates all existing sessions.
SESSION_SECRET=your-32-char-hex-secret-here

# Server
PORT=4000
NODE_ENV=production
